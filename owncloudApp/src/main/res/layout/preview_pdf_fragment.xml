<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/top"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:filterTouchesWhenObscured="true"
    android:background="?attr/colorSurface"
    tools:context=".ui.preview.PreviewPdfFragment">

    <com.owncloud.android.ui.preview.PdfViewer
        android:id="@+id/pdf_viewer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/pdf_page_navigation_bar"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/pdf_page_navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_navigation_bar_height"
        android:layout_alignParentBottom="true"
        android:background="@color/homecloud_bar_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/standard_margin"
        android:paddingEnd="@dimen/standard_margin"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/pdf_page_previous"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/homecloud_pdf_preview_page_previous"
                android:src="@drawable/ic_arrow_down"
                android:rotation="180"
                android:tint="@color/selector_pdf_preview_icon_tint" />

            <TextView
                android:id="@+id/pdf_page_indicator"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_marginHorizontal="8dp"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorPrimary"
                tools:text="1/4" />

            <ImageButton
                android:id="@+id/pdf_page_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/homecloud_pdf_preview_page_next"
                android:src="@drawable/ic_arrow_down"
                android:tint="@color/selector_pdf_preview_icon_tint" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/pdf_zoom_out"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/homecloud_pdf_preview_zoom_out"
                android:src="@drawable/ic_zoom_out"
                android:tint="@color/selector_pdf_preview_icon_tint" />

            <TextView
                android:id="@+id/pdf_zoom_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:drawableEnd="@drawable/ic_arrow_drop_down"
                android:drawablePadding="4dp"
                android:gravity="center"
                android:padding="8dp"
                android:layout_marginHorizontal="8dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorPrimary"
                tools:text="125%" />

            <ImageButton
                android:id="@+id/pdf_zoom_in"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/homecloud_pdf_preview_zoom_in"
                android:src="@drawable/ic_zoom_in"
                android:tint="@color/selector_pdf_preview_icon_tint" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
